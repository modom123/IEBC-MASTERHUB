<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IEBC — Control. Grow. Be Efficient.</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: { DEFAULT: '#0F4C81', light: '#2A65A8', dark: '#082D4F' },
            gold: { DEFAULT: '#D4AF37', light: '#E5C55A', dark: '#B39226' },
            bg: { DEFAULT: '#FFFFFF', subtle: '#F8FAFC' },
            text: { primary: '#0F172A', secondary: '#475569' }
          },
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    .step { display: none; }
    .step.active { display: block; }
  </style>
</head>
<body class="bg-bg text-text-primary">

  <!-- Navigation -->
  <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center gap-2 cursor-pointer" onclick="showTab('website')">
        <span class="text-2xl font-bold text-primary tracking-tight">IEBC</span>
        <span class="w-1.5 h-1.5 rounded-full bg-gold mt-2"></span>
      </div>
      <div class="hidden md:flex gap-6 text-sm font-medium text-text-secondary">
        <button onclick="showTab('website')" class="hover:text-primary transition">Website</button>
        <button onclick="showTab('accounting')" class="hover:text-primary transition">Accounting Suite</button>
        <button onclick="showTab('hub')" class="hover:text-primary transition">Master Hub</button>
        <button onclick="showTab('checkout')" class="hover:text-primary transition">Checkout Demo</button>
      </div>
      <button onclick="showTab('checkout')" class="btn-primary !py-2 !px-4 !text-sm">📅 Book Call</button>
    </div>
  </nav>

  <!-- WEBSITE TAB -->
  <div id="website" class="tab-content active">
    <header class="py-20 px-6 text-center bg-gradient-to-b from-white to-gray-50">
      <h1 class="text-4xl md:text-6xl font-extrabold text-text-primary mb-6 tracking-tight">
        Stop Working <span class="text-primary">In</span> Your Business.<br>Start Working <span class="text-primary">On</span> It.
      </h1>
      <p class="text-xl text-text-secondary max-w-3xl mx-auto mb-8">Formation · Accounting · Websites · Hubs · 60 Experts. Avg. time saved: 22 hrs/wk.</p>
      <div class="flex justify-center gap-4 flex-wrap">
        <button onclick="showTab('checkout')" class="bg-primary text-white px-8 py-4 rounded-xl text-lg font-bold hover:bg-primary-dark transition shadow-lg">🛒 Get Started</button>
        <button class="bg-white border-2 border-gray-200 text-text-primary px-8 py-4 rounded-xl text-lg font-bold hover:bg-gray-50 transition">📅 Free Discovery Call</button>
      </div>
    </header>

    <section class="py-16 px-6 max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-10">Simple, Transparent Pricing</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl border border-gray-200 p-6 flex flex-col">
          <h3 class="text-xl font-bold text-text-primary">Solo</h3>
          <p class="text-3xl font-extrabold text-primary my-3">$19<span class="text-base font-normal text-gray-500">/mo</span></p>
          <ul class="space-y-2 mb-6 flex-1 text-sm text-text-secondary">
            <li>✅ AI receipt scan (150/mo)</li><li>✅ GPS mileage tracker</li><li>✅ Schedule C export</li>
          </ul>
          <button onclick="showTab('checkout')" class="btn-primary mt-auto">Start Free Trial</button>
        </div>
        <div class="bg-white rounded-xl border-2 border-primary p-6 flex flex-col relative scale-105 shadow-xl">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gold text-white px-3 py-1 rounded-full text-xs font-bold">MOST POPULAR</span>
          <h3 class="text-xl font-bold text-text-primary">Business</h3>
          <p class="text-3xl font-extrabold text-primary my-3">$49<span class="text-base font-normal text-gray-500">/mo</span></p>
          <ul class="space-y-2 mb-6 flex-1 text-sm text-text-secondary">
            <li>✅ Unlimited AI scan</li><li>✅ 1099 contractor tracker</li><li>✅ QuickBooks export</li><li>✅ 3 users + Consultant</li>
          </ul>
          <button onclick="showTab('checkout')" class="btn-primary mt-auto">Start Free Trial</button>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-6 flex flex-col">
          <h3 class="text-xl font-bold text-text-primary">Pro</h3>
          <p class="text-3xl font-extrabold text-primary my-3">$99<span class="text-base font-normal text-gray-500">/mo</span></p>
          <ul class="space-y-2 mb-6 flex-1 text-sm text-text-secondary">
            <li>✅ Multi-entity support</li><li>✅ Payroll integration</li><li>✅ Unlimited users + API</li><li>✅ 2 IE Consultants</li>
          </ul>
          <button onclick="showTab('checkout')" class="btn-primary mt-auto">Start Free Trial</button>
        </div>
      </div>
    </section>

    <footer class="bg-primary text-white py-12 text-center px-6">
      <h2 class="text-3xl font-bold mb-4">Ready to take Control?</h2>
      <p class="text-blue-100 mb-6 max-w-2xl mx-auto">Book a free 30-min call. See a live demo. Get a proposal. No pressure.</p>
      <button class="bg-white text-primary px-6 py-3 rounded-lg font-bold hover:bg-blue-50">📅 Book Free Discovery Call</button>
      <div class="mt-8 text-sm text-blue-200">© 2026 IEBC. Integrated Efficiency Business Consultants.</div>
    </footer>
  </div>

  <!-- ACCOUNTING SUITE TAB -->
  <div id="accounting" class="tab-content">
    <div class="p-6 max-w-7xl mx-auto space-y-6">
      <div class="flex justify-between items-center bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
        <h1 class="text-2xl font-bold text-primary">📊 Efficient by IEBC</h1>
        <div class="flex gap-3">
          <button class="btn-secondary !py-1.5 !text-sm">📥 Import CSV/QBO</button>
          <button class="btn-primary !py-1.5 !text-sm">+ Add Transaction</button>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-green-50 p-5 rounded-xl border border-green-200"><p class="text-sm text-green-700">Revenue (MTD)</p><p class="text-2xl font-bold text-green-800">$24,850</p></div>
        <div class="bg-red-50 p-5 rounded-xl border border-red-200"><p class="text-sm text-red-700">Expenses (MTD)</p><p class="text-2xl font-bold text-red-800">$9,320</p></div>
        <div class="bg-blue-50 p-5 rounded-xl border border-blue-200"><p class="text-sm text-blue-700">Net Profit</p><p class="text-2xl font-bold text-blue-800">$15,530</p></div>
        <div class="bg-gold/10 p-5 rounded-xl border border-gold/30"><p class="text-sm text-gold-dark">Cash on Hand</p><p class="text-2xl font-bold text-gold-dark">$47,200</p></div>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden p-6">
        <h3 class="font-semibold mb-4">Recent Transactions</h3>
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-text-secondary"><tr><th class="p-3 text-left">Date</th><th class="p-3 text-left">Description</th><th class="p-3 text-left">Category</th><th class="p-3 text-right">Amount</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr class="hover:bg-gray-50"><td class="p-3 text-gray-500">2026-04-03</td><td class="p-3">AWS Cloud Services</td><td class="p-3">Software & Tech</td><td class="p-3 text-right font-mono text-red-600">-$284.00</td></tr>
            <tr class="hover:bg-gray-50"><td class="p-3 text-gray-500">2026-04-02</td><td class="p-3">Client Payment — Apex Co.</td><td class="p-3">Service Revenue</td><td class="p-3 text-right font-mono text-green-600">+$4,200.00</td></tr>
            <tr class="hover:bg-gray-50"><td class="p-3 text-gray-500">2026-04-01</td><td class="p-3">Client Lunch — The Capital Grille</td><td class="p-3">Meals & Entertainment</td><td class="p-3 text-right font-mono text-red-600">-$127.00</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- MASTER HUB TAB -->
  <div id="hub" class="tab-content">
    <div class="p-6 max-w-7xl mx-auto space-y-6 text-text-primary">
      <div class="flex justify-between items-center bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
        <h1 class="text-2xl font-bold text-primary">🏢 IEBC Master Hub</h1>
        <div class="flex gap-2">
          <button class="btn-secondary !py-1.5 !text-sm">📅 Calendar</button>
          <button class="btn-primary !py-1.5 !text-sm">+ New Client</button>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-xl border border-gray-200"><p class="text-sm text-gray-500">Active Builds</p><p class="text-2xl font-bold">0</p></div>
        <div class="bg-white p-5 rounded-xl border border-gray-200"><p class="text-sm text-gray-500">Hot Leads</p><p class="text-2xl font-bold">0</p></div>
        <div class="bg-white p-5 rounded-xl border border-gray-200"><p class="text-sm text-gray-500">Tasks Due</p><p class="text-2xl font-bold">0</p></div>
        <div class="bg-white p-5 rounded-xl border border-gold/30"><p class="text-sm text-gold-dark">MRR Target</p><p class="text-2xl font-bold text-gold-dark">$0</p></div>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="font-bold mb-3">⚡ Daily Briefing</h3>
        <p class="text-gray-600 text-sm">Connect Supabase in Settings to activate live client sync, AI routing, and real-time MRR tracking.</p>
      </div>
    </div>
  </div>

  <!-- CHECKOUT FLOW TAB -->
  <div id="checkout" class="tab-content">
    <div class="min-h-screen bg-gray-50 flex flex-col items-center py-10 px-4">
      <div class="w-full max-w-4xl mb-8 flex items-center justify-between relative">
        <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-200 -z-0"></div>
        <div class="relative z-10 flex flex-col items-center"><div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm bg-primary text-white border-2 border-primary">1</div><span class="text-xs font-medium mt-2 text-primary">Plan</span></div>
        <div class="relative z-10 flex flex-col items-center"><div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm bg-white text-gray-400 border-2 border-gray-300">2</div><span class="text-xs font-medium mt-2 text-gray-400">Consultant</span></div>
        <div class="relative z-10 flex flex-col items-center"><div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm bg-white text-gray-400 border-2 border-gray-300">3</div><span class="text-xs font-medium mt-2 text-gray-400">Account</span></div>
        <div class="relative z-10 flex flex-col items-center"><div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm bg-white text-gray-400 border-2 border-gray-300">4</div><span class="text-xs font-medium mt-2 text-gray-400">Payment</span></div>
        <div class="relative z-10 flex flex-col items-center"><div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm bg-white text-gray-400 border-2 border-gray-300">5</div><span class="text-xs font-medium mt-2 text-gray-400">Connect</span></div>
      </div>
      <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200 w-full max-w-3xl">
        <div id="step1" class="step active space-y-6">
          <h2 class="text-2xl font-bold text-center">Choose Your Plan</h2>
          <div class="grid grid-cols-3 gap-4">
            <button onclick="nextStep(2)" class="p-4 rounded-xl border-2 text-center hover:border-blue-300 transition"><div class="font-bold">Solo</div><div class="text-xl font-extrabold text-primary">$19/mo</div></button>
            <button onclick="nextStep(2)" class="p-4 rounded-xl border-2 border-blue-600 bg-blue-50 text-center"><div class="font-bold">Business</div><div class="text-xl font-extrabold text-primary">$49/mo</div></button>
            <button onclick="nextStep(2)" class="p-4 rounded-xl border-2 text-center hover:border-blue-300 transition"><div class="font-bold">Pro</div><div class="text-xl font-extrabold text-primary">$99/mo</div></button>
          </div>
        </div>
        <div id="step2" class="step space-y-6">
          <h2 class="text-2xl font-bold text-center">Choose Your Consultant</h2>
          <div class="space-y-3">
            <label class="flex items-center gap-4 p-4 border border-gray-200 rounded-lg hover:border-blue-500 cursor-pointer"><input type="radio" name="consultant" checked class="accent-blue-600"><div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center font-bold text-gray-600">MR</div><div><p class="font-bold">Marcus Reynolds</p><p class="text-xs text-blue-600">Tax · Freelance · 1099</p></div></label>
            <label class="flex items-center gap-4 p-4 border border-gray-200 rounded-lg hover:border-blue-500 cursor-pointer"><input type="radio" name="consultant" class="accent-blue-600"><div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center font-bold text-gray-600">TP</div><div><p class="font-bold">Tanya Patel</p><p class="text-xs text-blue-600">Small Biz · LLC · HR</p></div></label>
          </div>
          <div class="flex justify-between"><button onclick="nextStep(1)" class="px-6 py-3 border rounded-lg">← Back</button><button onclick="nextStep(3)" class="flex-1 btn-primary">Continue</button></div>
        </div>
        <div id="step3" class="step space-y-6 text-center">
          <h2 class="text-2xl font-bold">Account Setup</h2>
          <input class="w-full p-3 border rounded-lg mb-3" placeholder="Business Name"><input class="w-full p-3 border rounded-lg mb-3" placeholder="Business Email">
          <div class="flex justify-between"><button onclick="nextStep(2)" class="px-6 py-3 border rounded-lg">← Back</button><button onclick="nextStep(4)" class="flex-1 btn-primary">Continue to Payment</button></div>
        </div>
        <div id="step4" class="step space-y-6 text-center">
          <h2 class="text-2xl font-bold">Secure Payment</h2>
          <input class="w-full p-3 border rounded-lg mb-3" placeholder="Cardholder Name"><input class="w-full p-3 border rounded-lg mb-3" placeholder="Card Number (Demo)">
          <div class="grid grid-cols-2 gap-4 mb-4"><input class="w-full p-3 border rounded-lg" placeholder="MM / YY"><input class="w-full p-3 border rounded-lg" placeholder="CVC"></div>
          <div class="flex justify-between"><button onclick="nextStep(3)" class="px-6 py-3 border rounded-lg">← Back</button><button onclick="nextStep(5)" class="flex-1 btn-primary">Start Free Trial</button></div>
        </div>
        <div id="step5" class="step space-y-6 text-center">
          <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto">✓</div>
          <h2 class="text-2xl font-bold">You're Live!</h2>
          <p class="text-gray-500">Your 30-day trial is active. Connect accounts to begin.</p>
          <button onclick="showTab('accounting')" class="btn-primary w-full">Launch Efficient Dashboard</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function showTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      window.scrollTo(0, 0);
    }
    function nextStep(stepNum) {
      document.querySelectorAll('.step').forEach(el => el.classList.remove('active'));
      document.getElementById('step' + stepNum).classList.add('active');
    }
  </script>
</body>
</html>
